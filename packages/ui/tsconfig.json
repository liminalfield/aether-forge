{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // The component layer is React, because the renderer is. React itself is a
    // peer dependency, so the application supplies the one copy that runs:
    // two copies in a process is a class of bug that is unpleasant to diagnose
    // and trivial to avoid.
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
