{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "e2e/**/*.ts",
    "measure/**/*.ts",
    "playwright.config.ts",
    "playwright.measure.config.ts",
    "src/**/*.ts"
  ]
}
