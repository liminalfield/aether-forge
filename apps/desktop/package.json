{
  "name": "aether-forge-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aether Forge desktop application",
  "license": "GPL-3.0-or-later",
  "author": "Aether Forge contributors",
  "homepage": "https://github.com/liminalfield/aether-forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liminalfield/aether-forge.git",
    "directory": "apps/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && node scripts/bundle-content.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "package": "electron-builder --publish never",
    "package:dir": "electron-builder --dir --publish never",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "xvfb-run --auto-servernum env -u WAYLAND_DISPLAY -u XDG_SESSION_TYPE playwright test",
    "measure": "playwright test --config playwright.measure.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.2"
  },
  "devDependencies": {
    "@aether-forge/core": "workspace:*",
    "@aether-forge/importer-datasworn": "workspace:*",
    "@aether-forge/system-ironsworn": "workspace:*",
    "@aether-forge/system-toy": "workspace:*",
    "@aether-forge/ui": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "catalog:",
    "vite": "7.3.6",
    "vitest": "catalog:"
  },
  "desktopName": "aether-forge.desktop"
}
